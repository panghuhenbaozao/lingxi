{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingxi-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingxi-cloud-db",
      "database_id": "9c67a7f3-bdbe-44da-86d6-66f46bd6022e"
    }
  ]
}
